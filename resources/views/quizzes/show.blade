    height: 100px;
    margin: auto;
}

.temporizador svg {
    position: absolute;
    top: 0;
    left: 0;
}

.temporizador circle {
    stroke-dasharray: 251.327;
    stroke-dashoffset: 251.327;
    transition: stroke-dashoffset 1s linear;
    stroke: #f59e0b;
    /* naranja */
}

#time-remaining {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-weight: bold;
    color: #f59e0b;
    font-size: 1.2rem;
}
</style>
